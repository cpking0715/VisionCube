# ═══════════════════════════════════════════════════════
# VisionCube 环境配置
# 复制本文件为 .env，填入对应的 API Key
# ═══════════════════════════════════════════════════════

# ── 基础配置 ──────────────────────────────────────────
DATABASE_URL=sqlite:///./data/visioncube.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── LLM 大模型（文案分析 / 改写 / 元信息生成） ────────
# 推荐：DeepSeek（性价比最高）或 阿里云通义千问
#
# DeepSeek:
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-xxx（在 https://platform.deepseek.com/ 获取）
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# 阿里云通义千问（DashScope）:
#   LLM_PROVIDER=qwen
#   LLM_API_KEY=sk-xxx（在 https://bailian.console.aliyun.com/ 获取）
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#   注：也可用专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── 语音转写 ASR（视频 → 文案） ──────────────────────
# 推荐：阿里云 FunASR（开源免费本地部署）或 阿里云语音识别
#
# 阿里云语音识别:
#   ASR_PROVIDER=aliyun
#   ASR_ACCESS_KEY_ID=xxx（在 https://nls.console.aliyun.com/ 获取）
#   ASR_ACCESS_KEY_SECRET=xxx
#   ASR_APP_KEY=xxx
#
# OpenAI Whisper（本地部署，免费，需 GPU）:
#   ASR_PROVIDER=whisper
#   ASR_MODEL_SIZE=large-v3  （tiny/base/small/medium/large-v3）
ASR_PROVIDER=
ASR_ACCESS_KEY_ID=
ASR_ACCESS_KEY_SECRET=
ASR_APP_KEY=
ASR_MODEL_SIZE=

# ── 语音合成 TTS（文案 → 配音） ──────────────────────
# 推荐：Edge TTS（免费，无需 Key）
#
# Edge TTS（免费，无需配置）:
#   TTS_PROVIDER=edge
#   TTS_VOICE=zh-CN-XiaoxiaoNeural  （可选音色见下方列表）
#
# 阿里云语音合成（更多音色）:
#   TTS_PROVIDER=aliyun
#   TTS_ACCESS_KEY_ID=xxx
#   TTS_ACCESS_KEY_SECRET=xxx
#   TTS_APP_KEY=xxx
#   TTS_VOICE=xiaoyun
#
# 常用 Edge TTS 中文音色：
#   zh-CN-XiaoxiaoNeural    - 温柔女声（默认）
#   zh-CN-YunxiNeural       - 阳光男声
#   zh-CN-YunjianNeural     - 磁性男声
#   zh-CN-XiaoyiNeural      - 活泼女声
#   zh-CN-YunyangNeural     - 新闻男声
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_ACCESS_KEY_ID=
TTS_ACCESS_KEY_SECRET=
TTS_APP_KEY=

# ── 数字人（配音 + 形象 → 口播视频） ─────────────────
# 推荐：硅基智能 或 HeyGen
#
# 硅基智能:
#   DH_PROVIDER=guiji
#   DH_API_KEY=xxx（在 https://www.guiji.ai/ 获取）
#   DH_AVATAR_ID=xxx
#
# HeyGen:
#   DH_PROVIDER=heygen
#   DH_API_KEY=xxx（在 https://app.heygen.com/ 获取）
#   DH_AVATAR_ID=xxx
DH_PROVIDER=
DH_API_KEY=
DH_AVATAR_ID=

# ── 内容审核（文本 + 视频合规检测） ──────────────────
# 推荐：阿里云内容安全
#
#   MODERATION_PROVIDER=aliyun
#   MODERATION_ACCESS_KEY_ID=xxx（在 https://green.console.aliyun.com/ 获取）
#   MODERATION_ACCESS_KEY_SECRET=xxx
MODERATION_PROVIDER=
MODERATION_ACCESS_KEY_ID=
MODERATION_ACCESS_KEY_SECRET=

# ── 素材库（B-roll / 背景素材检索） ──────────────────
# 推荐：Pexels（免费高质量）
#
#   STOCK_PROVIDER=pexels
#   STOCK_API_KEY=xxx（在 https://www.pexels.com/api/ 获取）
STOCK_PROVIDER=
STOCK_API_KEY=

# ── 视频解析（抖音链接 → 无水印视频下载） ────────────
# 推荐：yt-dlp（开源免费，本地运行）
#
#   PARSE_PROVIDER=ytdlp
#   PARSE_DOUYIN_COOKIE=xxx（可选，Cookie 可解锁更多资源）
#     获取方式：浏览器登录 douyin.com → F12 → Application → Cookies → 复制全部
PARSE_PROVIDER=ytdlp
PARSE_DOUYIN_COOKIE=
